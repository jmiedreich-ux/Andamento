{
  "name": "andamento",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first planning, decision, and work-authorization studio.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node app/server/main.mjs",
    "test": "node --test app/test/unit/*.test.mjs app/test/integration/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test app/test/unit/*.test.mjs app/test/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "qa:detect": "node .agents/skills/impeccable/scripts/detect.mjs --json app/public/index.html app/public/app.mjs app/public/styles.css"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1"
  }
}
